# This file was generated using idf.py save-defconfig, then hand-merged with the
# ESP-Hosted/NimBLE and flash-layout settings this template's WiFi/BLE/OTA features need.
# Espressif IoT Development Framework (ESP-IDF) 6.1.0 Project Minimal Configuration
#
# Settings here apply to every board this template supports. Board-specific values (pins,
# panel, onboard codec, ESP-Hosted SDIO pins, ...) are not set here: selecting the board in
# menuconfig (Espressynth -> Board Configuration) derives them in main/Kconfig.projbuild.
# idf.py only fills in symbols not already present in sdkconfig from this file, so after the
# first configure menuconfig/sdkconfig is authoritative. Add-on hardware (WM8960 HAT, NS4168 or
# PDM breakouts, ...) is enabled and wired in menuconfig as well.

CONFIG_IDF_TARGET="esp32p4"

# Conservative default for I2C0. I2C1 uses the same choice default when enabled.
CONFIG_APP_I2C0_SPEED_50KHZ=y

# External CV hardware. Enabled drivers search every enabled I2C bus at startup.
CONFIG_APP_ADS1115_SUPPORT=y
CONFIG_APP_GP8413_SUPPORT=y

# Digital In/Out (raw GPIO) widgets - which physical pins are used is chosen at runtime in
# the Settings dialog, not here.
CONFIG_APP_ENABLE_GPIO_INPUT=y
CONFIG_APP_ENABLE_GPIO_OUTPUTS=y

# --- Compiler optimization: ESP-IDF defaults to "Debug (-Og)". Measured on real hardware
# (main/audio/engine/SynthEngine.h's render task): a trivial 4-voice patch (one oscillator +
# one ADSR per voice) already overran its ~2.9ms block budget continuously at -Og (render alone
# took ~3.0-3.3ms), causing audible dropouts. "Optimization for Performance (-O2)" brings the
# same patch down to ~2.2ms peak - comfortably under budget, zero overruns - so this is a
# correctness requirement for the audio engine, not just a nice-to-have speedup. ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- PSRAM: every supported board's ESP32-P4NRW32 module has 32 MB of PSRAM stacked in the
# package. Off by default in ESP-IDF, so enable it explicitly; HEX line mode / 200 MHz are this
# chip's only supported PSRAM settings and are already the Kconfig defaults once CONFIG_SPIRAM
# is on. ---
CONFIG_SPIRAM=y
# Keep TCP/IP buffers out of the internal DMA heap needed by ESP-Hosted SDIO.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# P4 SDMMC DMA can use PSRAM; graph rebuilds must not exhaust its RX staging buffers.
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y

# --- Flash layout: all supported boards ship 16 MB of flash; the default single-app table only
# used 2 MB (and left the app 96% full). Custom table adds "slave_fw", a staging
# partition for the ESP32-C6 co-processor image pushed by Feature::Hosted::OTA
# (see main/partitions.csv, main/features/hosted/hosted_ota.hpp, coprocessor_fw/). ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- ESP-Hosted: Wi-Fi + Bluetooth LE co-processor link (ESP32-P4 -> ESP32-C6 over
# the on-board SDIO bus). Used by JC8012P4A1, JC1060P470C and the Waveshare dev kit - all three
# wire an ESP32-C6 over SDIO (see PIN_SDIO_* in main/boards/*.hpp). A custom board without that
# co-processor should turn these back off in its own sdkconfig.defaults.custom_p4.
# See main/features/wifi/wifi_manager.hpp and main/features/ble/ble_manager.hpp.
# Bluetooth LE itself only takes effect once "Application Features -> Enable
# Bluetooth LE Subsystem" is turned on; left configured here so menuconfig doesn't
# need options hand-tuned across two unrelated submenus to flip it on. ---
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y

# NimBLE connection/GATT timing assumes a 1kHz FreeRTOS tick.
CONFIG_FREERTOS_HZ=1000

# CLI "top" command (main/cli/commands/cmd_top.hpp) needs uxTaskGetSystemState() and
# per-task/per-core run time stats (CPU%), all compiled out unless this is on. Also selects
# CONFIG_FREERTOS_USE_TRACE_FACILITY and CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Adds TaskStatus_t::xCoreID (core a task is pinned to), used by the "top" command's
# Core column. Only valid for the classic (non-SMP) kernel this project builds.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Run time stats clock is esp_timer_get_time() (64-bit microseconds since boot). With the
# default uint32_t counter type that value gets truncated and wraps every ~71.6 minutes of
# uptime, corrupting "top"/"htop" CPU% (stale pre-wrap per-task counters read against a
# post-wrap total -- e.g. an idle task's counter can compute as 300-400%+). uint64_t avoids
# the wrap.
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# This project pins every task it creates to MAIN_CORE or AUDIO_CORE (see main/app_core.hpp);
# pin lwip's tcpip_thread the same way instead of leaving it as CONFIG_LWIP_TCPIP_TASK_AFFINITY_NO_AFFINITY.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
# Let the scheduler tick preempt USB/SDIO interrupts on the busy main core.
CONFIG_FREERTOS_CORETIMER_SYSTIMER_LVL3=y

# LVGL default theme in dark mode.
CONFIG_LV_THEME_DEFAULT_DARK=y
# 33 ms = the RGB panel's ~28 Hz scan-out (12 MHz pixel clock); the EEZ UI timer runs at 33 ms too. Reuse style and rounded-edge calculations.
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=64
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y

# --- Boot splash screen (main/features/display/display_lvgl.hpp): the embedded splash PNG is
# decoded via LVGL's bundled lodepng, read through a stdio-backed LVGL filesystem driver
# registered under drive letter 'S' (ASCII 83) so lv_image_set_src() can open it straight from
# LittleFS ("S:/littlefs/system/splash.png") - no path prefix configured
# (CONFIG_LV_FS_STDIO_PATH left empty), so paths passed to LVGL must always be the full
# absolute VFS path. ---
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83

# Keep the decoded splash in LVGL's image cache during its display interval. 4 MiB comfortably
# holds one decoded 1024x600 ARGB8888 frame with headroom for future images; the image buffer
# allocator in display_lvgl.hpp places the pixel data in PSRAM.
CONFIG_LV_CACHE_DEF_SIZE=4194304
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=4

# LVGL's own internal log (LV_LOG_WARN/ERROR, e.g. from the image decoder/cache) is otherwise
# completely silent - CONFIG_LV_USE_LOG was off, so a failed PNG decode never printed anything at
# all, anywhere. CONFIG_LV_LOG_PRINTF=y routes it straight to printf/UART with no extra callback
# code needed. WARN threshold catches WARN+ERROR without the very chatty TRACE/INFO levels.
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# LV_MEM_POOL_ALLOC (root CMakeLists.txt) puts this pool in PSRAM. The old 4 MB was sized for
# lodepng's decode scratch, which the hardware-JPEG splash no longer needs. Measured on the
# CrowPanel 5" (lv_mem_monitor via /api/diagnostics/memory): ~35 KB used, 42 KB peak. 1 MB
# leaves >20x headroom for cached page views.
CONFIG_LV_MEM_SIZE_KILOBYTES=1024

# --- Web server capacity for the synth engine's browser UI (main/features/synth/
# synth_web_api.hpp): a persistent /ws connection for the whole session, on top of overlapping
# preset/sample-list/file-explorer requests and static asset fetches. Off/at their default by
# default in ESP-IDF, so enable/raise explicitly; harmless overhead when Feature::Web/Synth are
# disabled. CONFIG_LWIP_MAX_SOCKETS must cover httpd's own config.max_open_sockets (see
# main/features/web/web_server.hpp's begin()), which is otherwise capped by this ceiling. ---
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# P4 memory audit: keep three central connections, bonding and MTU 256.
# Dynamic NimBLE data uses PSRAM; fixed pool and Hosted queue limits tested separately.
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=20
CONFIG_ESP_HOSTED_HOST_SDIO_TX_Q_SIZE=12
CONFIG_ESP_HOSTED_HOST_SDIO_RX_Q_SIZE=12
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
