        cutoffLog2Ratio = log2f(cutoffMaxHz / cutoffLo);
        const float resonanceLo = resonanceMinQ <= 0.0f ? 0.0001f : resonanceMinQ;
        resonanceLog2Ratio = log2f(resonanceMaxQ / resonanceLo);
    }







