               2
# 915 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/SynthEngine.h"
                       );
    const long size = ftell(f);
    fseek(f, 0, 
# 917 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/SynthEngine.h" 3 4
               0
# 917 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/SynthEngine.h"
                       );
    if (size <= 0 || static_cast<size_t>(size) > synth::kMaxPresetBytes)
    {
        fclose(f);
        return nullptr;
    }

    const size_t bufferSize = static_cast<size_t>(size);
    char *buffer = static_cast<char *>(heap_caps_malloc(bufferSize, (1<<10) | (1<<2)));
    if (buffer == nullptr)
    {
        buffer = static_cast<char *>(heap_caps_malloc(bufferSize, (1<<11) | (1<<2)));
    }
    if (buffer == nullptr)
    {
        fclose(f);
        return nullptr;
    }
    const size_t readBytes = fread(buffer, 1, static_cast<size_t>(size), f);
    fclose(f);
    if (readBytes != static_cast<size_t>(size))
    {
        heap_caps_free(buffer);
        return nullptr;
    }
    memorydiag::captureReloadPhase(reloadGeneration, memorydiag::ReloadPhase::FileBufferReady);

    void *docStorage = heap_caps_malloc(sizeof(PresetDoc), (1<<10) | (1<<2));
    if (docStorage == nullptr)
    {
        docStorage = heap_caps_malloc(sizeof(PresetDoc), (1<<11) | (1<<2));
    }
    if (docStorage == nullptr)
    {
        heap_caps_free(buffer);
        return nullptr;
    }
    PresetDoc *doc = new (docStorage) PresetDoc();
    memorydiag::captureReloadPhase(reloadGeneration, memorydiag::ReloadPhase::PresetDocReady);
    const bool ok = parsePreset(buffer, readBytes, *doc);
    memorydiag::captureReloadPhase(reloadGeneration, memorydiag::ReloadPhase::Parsed);
    heap_caps_free(buffer);
    memorydiag::captureReloadPhase(reloadGeneration, memorydiag::ReloadPhase::FileBufferFreed);
    if (!ok)
    {
        destroyPresetDoc(doc);
        return nullptr;
    }
    return doc;
}
