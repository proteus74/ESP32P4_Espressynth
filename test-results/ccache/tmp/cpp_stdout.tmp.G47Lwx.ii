inline float cvToRange(float volts, float minVal, float maxVal, bool log)
{
    float v = volts * kInvMaxVolts;
    if (v < 0.0f)
        v = 0.0f;
    if (v > 1.0f)
        v = 1.0f;
    if (log)
    {
        const float lo = minVal <= 0.0f ? 0.0001f : minVal;
        return lo * powf(maxVal / lo, v);
    }
    return minVal + v * (maxVal - minVal);
}
