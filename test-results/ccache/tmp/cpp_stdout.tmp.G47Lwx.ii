static inline uint32_t lv_swap_bytes_32(uint32_t x)
{
    return (x << 24)
           | ((x & 0x0000ff00U) << 8)
           | ((x & 0x00ff0000U) >> 8)
           | (x >> 24);
}






static inline uint16_t lv_swap_bytes_16(uint16_t x)
{
    return (x << 8) | (x >> 8);
}






