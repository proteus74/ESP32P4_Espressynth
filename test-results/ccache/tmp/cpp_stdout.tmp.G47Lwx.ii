inline bool allPortsConstantForBlock(const NodeInstance &inst, int portCount, size_t frames, float *values)
{
    for (int p = 0; p < portCount; ++p)
    {
        if (!audioPortConstantForBlock(inst, p, frames, values[p]))
        {
            return false;
        }
    }
    return true;
}
