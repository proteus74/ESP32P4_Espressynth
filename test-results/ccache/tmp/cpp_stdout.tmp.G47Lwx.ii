        constexpr static unsigned long long log_type = ESP_LOG_ARGS_TYPE_POINTER;
    };

    template <>
    struct EspLogArgType<uint8_t*> {
        constexpr static unsigned long long log_type = ESP_LOG_ARGS_TYPE_POINTER;
