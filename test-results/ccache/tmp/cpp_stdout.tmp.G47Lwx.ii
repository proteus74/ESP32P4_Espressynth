# 110 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/features/synth/UsbMidiEvent.h"
    size_t toJson(char *buffer, size_t bufferSize, uint32_t uptimeMs, const char *portLabel) const
    {
        const uint8_t ch0 = status & 0x0F;
        switch (codeIndex)
        {
        case 0x8:
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"note_off\",\"channel\":%u,\"note\":%u,"
                             "\"velocity\":%u,\"time\":%lu,\"port\":\"%s\",\"message\":\"note_off channel=%u "
                             "note=%u velocity=%u\"}",
                             sourceAddress, ch0, data1, data2, static_cast<unsigned long>(uptimeMs), portLabel, ch0,
                             data1, data2);
        case 0x9:
        {
            const char *midiType = data2 == 0 ? "note_off" : "note_on";
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"%s\",\"channel\":%u,\"note\":%u,"
                             "\"velocity\":%u,\"time\":%lu,\"port\":\"%s\",\"message\":\"%s channel=%u note=%u "
                             "velocity=%u\"}",
                             sourceAddress, midiType, ch0, data1, data2, static_cast<unsigned long>(uptimeMs),
                             portLabel, midiType, ch0, data1, data2);
        }
        case 0xA:
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"polytouch\",\"channel\":%u,"
                             "\"note\":%u,\"value\":%u,\"time\":%lu,\"port\":\"%s\",\"message\":\"polytouch "
                             "channel=%u note=%u value=%u\"}",
                             sourceAddress, ch0, data1, data2, static_cast<unsigned long>(uptimeMs), portLabel, ch0,
                             data1, data2);
        case 0xB:
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"control_change\",\"channel\":%u,"
                             "\"control\":%u,\"value\":%u,\"time\":%lu,\"port\":\"%s\",\"message\":\""
                             "control_change channel=%u control=%u value=%u\"}",
                             sourceAddress, ch0, data1, data2, static_cast<unsigned long>(uptimeMs), portLabel, ch0,
                             data1, data2);
        case 0xC:
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"program_change\",\"channel\":%u,"
                             "\"program\":%u,\"time\":%lu,\"port\":\"%s\",\"message\":\"program_change channel=%u "
                             "program=%u\"}",
                             sourceAddress, ch0, data1, static_cast<unsigned long>(uptimeMs), portLabel, ch0, data1);
        case 0xD:
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"aftertouch\",\"channel\":%u,"
                             "\"value\":%u,\"time\":%lu,\"port\":\"%s\",\"message\":\"aftertouch channel=%u "
                             "value=%u\"}",
                             sourceAddress, ch0, data1, static_cast<unsigned long>(uptimeMs), portLabel, ch0, data1);
        case 0xE:
        {
            const int16_t bend = static_cast<int16_t>(((data2 & 0x7F) << 7) | (data1 & 0x7F)) - 8192;
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"pitchwheel\",\"channel\":%u,"
                             "\"value\":%d,\"time\":%lu,\"port\":\"%s\",\"message\":\"pitchwheel channel=%u "
                             "value=%d\"}",
                             sourceAddress, ch0, bend, static_cast<unsigned long>(uptimeMs), portLabel, ch0, bend);
        }
        default:
            return snprintf(buffer, bufferSize,
                             "{\"type\":\"midi\",\"address\":%u,\"midiType\":\"other\",\"channel\":%u,\"cin\":%u,"
                             "\"time\":%lu,\"port\":\"%s\",\"message\":\"other cin=0x%X status=0x%02X\"}",
                             sourceAddress, ch0, codeIndex, static_cast<unsigned long>(uptimeMs), portLabel,
                             codeIndex, status);
        }
    }
};
# 19 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/SoundFontPlayer.h" 2

namespace
{
constexpr char kSoundFontTag[] = "soundfont";
constexpr size_t kMaxSf2FileBytes = 14U * 1024U * 1024U;

bool endsWithSf2(const char *path)
{
    const size_t len = path != nullptr ? strlen(path) : 0;
    if (len < 4) return false;
    const char *ext = path + len - 4;
    return ext[0] == '.' && (ext[1] == 's' || ext[1] == 'S') &&
           (ext[2] == 'f' || ext[2] == 'F') && ext[3] == '2';
}

bool safeRelativePath(const char *path)
{
    if (path == nullptr || path[0] == '\0' || path[0] == '/' || path[0] == '\\' || !endsWithSf2(path)) return false;
    if (strstr(path, "..") != nullptr || strchr(path, '\\') != nullptr || strchr(path, ':') != nullptr) return false;
    return true;
}
}

namespace soundfont
{
struct LoadConfig
{
    const char *volume;
    const char *relativePath;
    int bank;
    int program;
    int maxVoices;
};


struct FileKey
{
    const char *volume;
    const char *relativePath;
};

namespace detail
{
# 86 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/SoundFontPlayer.h"
struct SoundFontFileCache
{
    char volume[8] = {0};
    char path[200] = {0};
    tsf *master = nullptr;
    bool inUse = false;
};
inline SoundFontFileCache *gFileCache = nullptr;

inline SoundFontFileCache *cacheStorage()
{
    if (gFileCache != nullptr)
    {
        return gFileCache;
    }
    void *storage = heap_caps_malloc(synth::kMaxWidgets * sizeof(SoundFontFileCache), (1<<10) | (1<<2));
    if (storage == nullptr)
    {
        storage = heap_caps_malloc(synth::kMaxWidgets * sizeof(SoundFontFileCache), (1<<11) | (1<<2));
    }
    gFileCache = static_cast<SoundFontFileCache *>(storage);
    if (gFileCache != nullptr)
    {
        for (size_t i = 0; i < synth::kMaxWidgets; ++i)
        {
            new (&gFileCache[i]) SoundFontFileCache();
        }
    }
    return gFileCache;
}

inline SoundFontFileCache *findCachedFile(const char *volume, const char *relativePath)
{
    SoundFontFileCache *cache = cacheStorage();
    if (cache == nullptr)
    {
        return nullptr;
    }
    for (size_t i = 0; i < synth::kMaxWidgets; ++i)
    {
        SoundFontFileCache &entry = cache[i];
        if (entry.inUse && strcmp(entry.volume, volume != nullptr ? volume : "") == 0 &&
            strcmp(entry.path, relativePath != nullptr ? relativePath : "") == 0)
        {
            return &entry;
        }
    }
    return nullptr;
}
}


inline bool resolvePath(const char *volume, const char *relativePath, char *out, size_t outSize)
{
    if (out == nullptr || outSize == 0 || !safeRelativePath(relativePath)) return false;
    const char *root = nullptr;
    if (volume != nullptr && strcmp(volume, "flash") == 0)
    {
        root = "/littlefs";
    }
    else if (volume != nullptr && strcmp(volume, "sd") == 0 && Feature::SDCard::is_mounted())
    {
        root = Feature::SDCard::MOUNT_POINT;
    }
    else
    {
        return false;
    }
    const int written = snprintf(out, outSize, "%s/%s", root, relativePath);
    return written > 0 && static_cast<size_t>(written) < outSize;
}
