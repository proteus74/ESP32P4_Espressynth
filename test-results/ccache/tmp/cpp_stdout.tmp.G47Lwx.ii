namespace Board {



template <size_t N>
constexpr bool pin_in_list(gpio_num_t pin, const gpio_num_t (&list)[N]) {
    if (pin == GPIO_NUM_NC) return false;
    for (gpio_num_t p : list) {
        if (p == pin) return true;
    }
    return false;
}







constexpr bool is_pin_reserved(gpio_num_t pin) {
    if (pin == GPIO_NUM_NC) return false;
    if (pin_in_list(pin, CurrentBoard::RESERVED_PINS)) return true;




    if (pin == static_cast<gpio_num_t>(7) ||
        pin == static_cast<gpio_num_t>(8)) return true;


    if (pin == static_cast<gpio_num_t>(32) ||
        pin == static_cast<gpio_num_t>(33)) return true;

    return false;
}

}
# 4 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/features/io/gpio_manager.hpp" 2







namespace Feature::IO {





inline bool is_pin_reserved_for_gpio_settings(gpio_num_t pin) {
    if (Board::is_pin_reserved(pin)) return true;

    if (pin == static_cast<gpio_num_t>(47) ||
        pin == static_cast<gpio_num_t>(46) ||
        pin == static_cast<gpio_num_t>(45) ||
        pin == static_cast<gpio_num_t>(4) ||
        pin == static_cast<gpio_num_t>(-1)) return true;

    return false;
}



inline void apply_gpio_settings() {
    const auto &gs = gpioSettings();
    for (uint8_t i = 0; i < gs.count; ++i) {
        const GpioEntry &e = gs.entries[i];
        if (e.pin < 0 || !((static_cast<gpio_num_t>(e.pin) >= 0) && (static_cast<gpio_num_t>(e.pin) < 55) && (((1ULL << (static_cast<gpio_num_t>(e.pin))) & (0x007FFFFFFFFFFFFF)) != 0))) continue;
        gpio_config_t cfg = {};
        cfg.pin_bit_mask = 1ULL << e.pin;
        cfg.mode = e.direction == GpioDirection::Output ? GPIO_MODE_OUTPUT : GPIO_MODE_INPUT;
        cfg.pull_up_en = (e.direction == GpioDirection::Input && e.pull == GpioPull::Up)
                             ? GPIO_PULLUP_ENABLE : GPIO_PULLUP_DISABLE;
        cfg.pull_down_en = (e.direction == GpioDirection::Input && e.pull == GpioPull::Down)
                             ? GPIO_PULLDOWN_ENABLE : GPIO_PULLDOWN_DISABLE;
        cfg.intr_type = GPIO_INTR_DISABLE;
        gpio_config(&cfg);
    }
}



inline bool gpio_read_level(int8_t pin) {
    if (pin < 0 || !((static_cast<gpio_num_t>(pin) >= 0) && (static_cast<gpio_num_t>(pin) < 55) && (((1ULL << (static_cast<gpio_num_t>(pin))) & (0x007FFFFFFFFFFFFF)) != 0))) return false;
    return gpio_get_level(static_cast<gpio_num_t>(pin)) != 0;
}
inline void gpio_write_level(int8_t pin, bool level) {
    if (pin < 0 || !((static_cast<gpio_num_t>(pin) >= 0) && (static_cast<gpio_num_t>(pin) < 55) && (((1ULL << (static_cast<gpio_num_t>(pin))) & (0x007FFFFFFFFFFFFF)) != 0))) return;
    gpio_set_level(static_cast<gpio_num_t>(pin), level ? 1 : 0);
}

}
