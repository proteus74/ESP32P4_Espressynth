    bool first = true;

    if (Feature::MIDI::is_connected()) {
        offset += snprintf(json + offset, sizeof(json) - static_cast<size_t>(offset), "%s\"USB MIDI (device %u)\"",
                            first ? "" : ",", static_cast<unsigned>(Feature::MIDI::connected_device_address()));
