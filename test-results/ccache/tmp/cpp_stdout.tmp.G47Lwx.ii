inline void floatToS32(const float *input, int32_t *output, size_t frames)
{
    if (input == nullptr || output == nullptr)
    {
        return;
    }
    constexpr float kScale = 2147483647.0f;
    for (size_t i = 0; i < frames; ++i)
    {
        float sample = input[i] * cv::kInvAudioPeakVolts;
        if (sample >= 1.0f)
        {
            output[i] = 
# 90 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/EspAudioEffectsAdapter.h" 3 4
                       (0x7fffffffL)
# 90 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/EspAudioEffectsAdapter.h"
                                ;
        }
        else if (sample <= -1.0f)
        {
            output[i] = 
# 94 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/EspAudioEffectsAdapter.h" 3 4
                       (-0x7fffffffL - 1)
# 94 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/EspAudioEffectsAdapter.h"
                                ;
        }
        else
        {
            output[i] = static_cast<int32_t>(std::lrintf(sample * kScale));
        }
    }
}

inline void s32ToFloat(const int32_t *input, float *output, size_t frames)
{
    if (input == nullptr || output == nullptr)
    {
        return;
    }
    constexpr float kScale = cv::kAudioPeakVolts / 2147483648.0f;
    for (size_t i = 0; i < frames; ++i)
    {
        output[i] = static_cast<float>(input[i]) * kScale;
    }
}

}
