                       "u" ") %s: " "Keyboard event queue full" "" "\n", esp_log_timestamp(), TAG ); } else { esp_log((__extension__({ esp_log_config_t __esp_log_config; __esp_log_config.data = (ESP_LOG_INFO); __esp_log_config;})), TAG, "" "I" " (%" 
# 361 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/features/usb/host/usb_hid_keyboard.hpp" 3 4
                       "l" 
# 361 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/features/usb/host/usb_hid_keyboard.hpp"
                       "u" ") %s: " "Keyboard event queue full" "" "\n", esp_log_timestamp(), TAG ); } } while(0); } } while(0); } while(0);
                    }
                }
            }
            for (size_t offset = 2; offset < 8; ++offset) {
                const uint8_t key = report[offset];
                if (key != 0 && !contains_key(previous_keyboard[address][index], key)) {
                    const Feature::Keyboard::Event event{address, index, key, '\0', shift, true, false};
                    if (keyboard_queue == nullptr || xQueueGenericSend( ( keyboard_queue ), ( &event ), ( 0 ), ( ( BaseType_t ) 0 ) ) != ( ( BaseType_t ) 1 )) {
                        do { do { if ((3 >= ((ESP_LOG_WARN) & ((1 << (3)) - 1)))) { do { if (((ESP_LOG_WARN) & ((1 << (3)) - 1))==ESP_LOG_ERROR) { esp_log((__extension__({ esp_log_config_t __esp_log_config; __esp_log_config.data = (ESP_LOG_ERROR); __esp_log_config;})), TAG, "" "E" " (%" 
