                       "u" ") %s: " "Keyboard event queue full" "" "\n", esp_log_timestamp(), TAG ); } else { esp_log((__extension__({ esp_log_config_t __esp_log_config; __esp_log_config.data = (ESP_LOG_INFO); __esp_log_config;})), TAG, "" "I" " (%" 
# 370 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/features/usb/host/usb_hid_keyboard.hpp" 3 4
                       "l" 
# 370 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/features/usb/host/usb_hid_keyboard.hpp"
                       "u" ") %s: " "Keyboard event queue full" "" "\n", esp_log_timestamp(), TAG ); } } while(0); } } while(0); } while(0);
                    }
                }
            }
            std::memcpy(previous_keyboard[address][index], report, 8);
        }
    } else if (usage == HID_USAGE_DESKTOP_MOUSE && length >= 3 && mouse_queue != nullptr) {
        const Feature::Mouse::Event event{
            report[0], static_cast<int8_t>(report[1]), static_cast<int8_t>(report[2]),
            length >= 4 ? static_cast<int8_t>(report[3]) : static_cast<int8_t>(0)
        };
        xQueueGenericSend( ( mouse_queue ), ( &event ), 0, ( ( BaseType_t ) 2 ) );
    }
}

