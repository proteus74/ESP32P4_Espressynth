             ",\"ledPin\":%d,\"ledCount\":%u,\"ledActiveCount\":%u,\"ledMaxCount\":%u}", led.pin,
             static_cast<unsigned>(led.count), static_cast<unsigned>(Feature::LedStrip::active_count()),
             static_cast<unsigned>(Feature::LedStrip::kMaxLeds));
