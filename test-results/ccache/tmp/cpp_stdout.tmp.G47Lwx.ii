inline float *outputPortBuffer(NodeInstance &inst, uint8_t port)
{
    if (port == 0)
        return inst.outL;
    if (port == 1)
        return inst.outR;
    const uint8_t extra = port - 2;




    if (inst.type == NodeType::OutputMultiplexer)
    {
        return inst.outputMux != nullptr && extra < kOutputMultiplexerMaxOutputs - 2 ? inst.outputMux->outPorts[extra]
                                                                                      : nullptr;
    }
    if (inst.type == NodeType::DrumSequencer)
    {
        return inst.drumSequencer != nullptr && extra < synth::kDrumSequencerMaxTracks * 2 - 2
                   ? inst.drumSequencer->outPorts[extra]
                   : nullptr;
    }
    return inst.link != nullptr && extra < synth::kLinkBusCount - 2 ? inst.link->busOut[extra] : nullptr;
}

inline const float *outputPortBuffer(const NodeInstance &inst, uint8_t port)
{
    if (port == 0)
        return inst.outL;
    if (port == 1)
        return inst.outR;
    const uint8_t extra = port - 2;
    if (inst.type == NodeType::OutputMultiplexer)
    {
        return inst.outputMux != nullptr && extra < kOutputMultiplexerMaxOutputs - 2 ? inst.outputMux->outPorts[extra]
                                                                                      : nullptr;
    }
    if (inst.type == NodeType::DrumSequencer)
    {
        return inst.drumSequencer != nullptr && extra < synth::kDrumSequencerMaxTracks * 2 - 2
                   ? inst.drumSequencer->outPorts[extra]
                   : nullptr;
    }
    return inst.link != nullptr && extra < synth::kLinkBusCount - 2 ? inst.link->busOut[extra] : nullptr;
}




namespace noderender
{
inline float portSample(const NodeInstance &inst, int portIdx, size_t i)
{
    return inst.inPorts[portIdx] != nullptr ? inst.inPorts[portIdx][i] : inst.controlValue[portIdx];
}

inline float clampf(float v, float lo, float hi)
{
    return v < lo ? lo : (v > hi ? hi : v);
}

inline bool controlPortConnected(const NodeInstance &inst, int portIdx)
{
    return (inst.controlConnectedPortMask & synth::portBit(portIdx)) != 0;
}


inline bool portIsFed(const NodeInstance &inst, int portIdx)
{
    return ((inst.controlConnectedPortMask | inst.audioConnectedPortMask) & synth::portBit(portIdx)) != 0;
}


inline float clampToRange(float value, float lo, float hi)
{
    return !(value >= lo) ? lo : (value > hi ? hi : value);
}
