    uint8_t *inDegree = new uint8_t[n]();

    auto markDependency = [&](uint16_t from, uint16_t to)
    {
        if (!adjacency[static_cast<size_t>(from) * n + to])
        {
            adjacency[static_cast<size_t>(from) * n + to] = true;
            ++inDegree[to];
        }
    };

    for (uint16_t c = 0; c < doc.connectionCount; ++c)
