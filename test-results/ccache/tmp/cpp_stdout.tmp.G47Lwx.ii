inline void delete_mailboxes() {
    for (QueueHandle_t& mailbox : s_cvInMailbox) {
        if (mailbox != nullptr) vQueueDelete(mailbox);
        mailbox = nullptr;
    }
    for (QueueHandle_t& mailbox : s_cvOutMailbox) {
        if (mailbox != nullptr) vQueueDelete(mailbox);
        mailbox = nullptr;
    }
}

