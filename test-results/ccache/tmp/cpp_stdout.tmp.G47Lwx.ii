struct FastLoopCtx
{
    NodeInstance *inst;
    PhaseOsc *phaseGen;
    OnePoleLowpass *gainSmooth;
    const float *ampBuf;
    const float *gainBuf;
    float ampScalar;
    float baseAmp;
    float ampConstantValue;
    float gainTarget;


    uint32_t phaseIncrementInt;
    float feedbackAmount;
    float *feedbackSample;
    bool gainFed;
    bool gainConverged;
    bool ampConstantForBlock;






    bool hasAmpRamp;
    float ampRampStart;
    float ampRampStep;
};






template <WaveType W>
__attribute__((section(".iram1" "." "33"))) inline void renderFastLoop(FastLoopCtx &c, size_t frames)
{
    for (size_t i = 0; i < frames; ++i)
    {
        const float amp = c.ampConstantForBlock ? c.ampConstantValue
                                                 : c.baseAmp + cv::vcaGain(c.ampBuf != nullptr ? c.ampBuf[i] : c.ampScalar, false);
        const float gainMul = c.gainFed ? cv::vcaGain(c.gainBuf[i], false)
                                         : (c.gainConverged ? c.gainTarget : c.gainSmooth->process(c.gainTarget));
        const float sample = c.phaseGen->processWithIncrementT<W>(c.phaseIncrementInt);
        c.inst->outL[i] = sample * amp * gainMul * cv::kAudioPeakVolts;
    }
}
# 123 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/nodes/OscillatorNode.h"
template <WaveType W>
__attribute__((section(".iram1" "." "34"))) inline void renderConstFastLoop(FastLoopCtx &c, size_t frames)
{
    const float amp = c.ampConstantValue;
    const float gainMul = c.gainTarget;
    for (size_t i = 0; i < frames; ++i)
    {
        const float sample = c.phaseGen->processWithIncrementT<W>(c.phaseIncrementInt);
        c.inst->outL[i] = sample * amp * gainMul * cv::kAudioPeakVolts;
    }
}







template <WaveType W>
__attribute__((section(".iram1" "." "35"))) inline void renderRampAmpFastLoop(FastLoopCtx &c, size_t frames)
{
    const float gainMul = c.gainTarget;
    float amp = c.ampRampStart;
    for (size_t i = 0; i < frames; ++i)
    {
        const float sample = c.phaseGen->processWithIncrementT<W>(c.phaseIncrementInt);
        c.inst->outL[i] = sample * amp * gainMul * cv::kAudioPeakVolts;
        amp += c.ampRampStep;
    }
}

template <WaveType W>
__attribute__((section(".iram1" "." "36"))) inline void renderFeedbackLoop(FastLoopCtx &c, size_t frames)
{
    float previous = *c.feedbackSample;
    for (size_t i = 0; i < frames; ++i)
    {
        const float amp = c.ampConstantForBlock ? c.ampConstantValue
                                                 : c.baseAmp + cv::vcaGain(c.ampBuf != nullptr ? c.ampBuf[i] : c.ampScalar, false);
        const float gainMul = c.gainFed ? cv::vcaGain(c.gainBuf[i], false)
                                         : (c.gainConverged ? c.gainTarget : c.gainSmooth->process(c.gainTarget));
        const float sample =
            c.phaseGen->processWithIncrementT<W, true>(c.phaseIncrementInt, previous * c.feedbackAmount);
        previous = sample;
        c.inst->outL[i] = sample * amp * gainMul * cv::kAudioPeakVolts;
    }
    *c.feedbackSample = previous;
}

template <WaveType W>
__attribute__((section(".iram1" "." "37"))) inline void renderSelectedFastLoop(FastLoopCtx &c, size_t frames, bool feedbackActive)
{
    if (feedbackActive)
        renderFeedbackLoop<W>(c, frames);
    else if (c.ampConstantForBlock && c.gainConverged && !c.gainFed)
        renderConstFastLoop<W>(c, frames);
    else if (c.hasAmpRamp && c.gainConverged && !c.gainFed)
        renderRampAmpFastLoop<W>(c, frames);
    else
        renderFastLoop<W>(c, frames);
}
}




