__attribute__((always_inline))
static inline uint8_t hal_utils_bitwise_reverse8(uint8_t n)
{
    n = ((n & 0xf0) >> 4) | ((n & 0x0f) << 4);
    n = ((n & 0xcc) >> 2) | ((n & 0x33) << 2);
    n = ((n & 0xaa) >> 1) | ((n & 0x55) << 1);
    return n;
}
# 114 "C:/esp/v6.1/esp-idf/components/hal/include/hal/hal_utils.h"
__attribute__((always_inline))
static inline uint32_t hal_utils_gcd(uint32_t num_1, uint32_t num_2)
{
    uint32_t a, b, rem;

    if (num_1 > num_2) {
        a = num_1;
        b = num_2;
    } else {
        b = num_2;
        a = num_1;
    }

    rem = a % b;
    while (rem != 0) {
        a = b;
        b = rem;
        rem = a % b;
    }
    return b;
}
# 144 "C:/esp/v6.1/esp-idf/components/hal/include/hal/hal_utils.h"
__attribute__((always_inline))
static inline uint32_t hal_utils_calc_lcm(uint32_t a, uint32_t b)
{
    a = a == 0 ? 1 : a;
    b = b == 0 ? 1 : b;
    return (a * b / hal_utils_gcd(a, b));
}





