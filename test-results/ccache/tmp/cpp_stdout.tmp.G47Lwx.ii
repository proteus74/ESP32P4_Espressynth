namespace wavetable
{





constexpr size_t kTableSize = 128;
constexpr uint32_t kIndexShift = 25;
constexpr uint32_t kFracMask = (1u << kIndexShift) - 1u;
constexpr float kFracScale = 1.0f / static_cast<float>(1u << kIndexShift);
static_assert(kTableSize == (1u << (32 - kIndexShift)), "kIndexShift must match kTableSize");
constexpr size_t kMaxTables = 16;

struct Bank
{
    std::atomic<int> refs{1};
    uint8_t count = 0;
    float data[kMaxTables][kTableSize] = {};
};

inline Bank *create()
{
    void *storage = heap_caps_malloc(sizeof(Bank), (1<<10) | (1<<2));
    if (storage == nullptr)
    {
        storage = heap_caps_malloc(sizeof(Bank), (1<<11) | (1<<2));
    }
    return storage != nullptr ? new (storage) Bank() : nullptr;
}

inline Bank *acquire(Bank *bank)
{
    if (bank != nullptr)
    {
        bank->refs.fetch_add(1, std::memory_order_relaxed);
    }
    return bank;
}

inline void release(Bank *bank)
{
    if (bank != nullptr && bank->refs.fetch_sub(1, std::memory_order_acq_rel) == 1)
    {
        bank->~Bank();
        heap_caps_free(bank);
    }
}

namespace detail
{
inline int base64Value(char c)
{
    if (c >= 'A' && c <= 'Z') return c - 'A';
    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
    if (c >= '0' && c <= '9') return c - '0' + 52;
    if (c == '+' || c == '-') return 62;
    if (c == '/' || c == '_') return 63;
    return -1;
}




inline bool decodeTable(const char *text, float *out)
{
    uint8_t pending[2] = {};
    size_t pendingCount = 0;
    size_t sample = 0;
    uint32_t accum = 0;
    int bits = 0;
    for (const char *c = text; *c != '\0' && sample < kTableSize; ++c)
    {
        if (*c == '=')
            break;
        const int v = base64Value(*c);
        if (v < 0)
            continue;
        accum = (accum << 6) | static_cast<uint32_t>(v);
        bits += 6;
        if (bits >= 8)
        {
            bits -= 8;
            pending[pendingCount++] = static_cast<uint8_t>((accum >> bits) & 0xFFu);
            if (pendingCount == 2)
            {
                const int16_t raw = static_cast<int16_t>(static_cast<uint16_t>(pending[0]) |
                                                         (static_cast<uint16_t>(pending[1]) << 8));
                float value = static_cast<float>(raw) * (1.0f / 32767.0f);
                out[sample++] = value < -1.0f ? -1.0f : value;
                pendingCount = 0;
            }
        }
    }
    return sample == kTableSize;
}

