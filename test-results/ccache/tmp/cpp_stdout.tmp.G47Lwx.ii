                const float tuneVolts = tuneNeedsAudioRate ? portSample(inst, 2, i) : tuneVoltsConst;
                inc = PhaseOsc::toPhaseInt(cv::hzFromPitchCv(pitchCv + (tuneVolts - kCenterVolts)) * kInvSampleRate);
