    }
    uint8_t count = 0;
    cJSON *entry = nullptr;
    for(entry = (item != 
# 1486 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/Graph.h" 3 4
   __null
# 1486 "C:/Users/jlassen/Documents/GIT_Projects/Audio/ESP32P4_Espressynth/main/audio/engine/Graph.h"
   ) ? (item)->child : 
