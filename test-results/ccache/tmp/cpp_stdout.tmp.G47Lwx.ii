inline bool is_connected() {
    return s_link_up;
}





inline esp_err_t get_ip_info(esp_netif_ip_info_t& ip_info) {
    if (s_eth_netif == nullptr) return 0x103;
    return esp_netif_get_ip_info(s_eth_netif, &ip_info);
}




