             strcmp(key, "layerCount") == 0 || strcmp(key, "activeLayer") == 0))
        {
            continue;
        }
        if (slot.type == NodeType::Button &&
            (strcmp(key, "buttonIndex") == 0 || strcmp(key, "buttonCount") == 0 ||
