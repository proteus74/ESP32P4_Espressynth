    for (size_t i = 0; i < frames; ++i)
    {
        const float sample = c.phaseGen->processWithIncrementT<W>(c.phaseIncrementInt, 0.0f, c.dutyThresholdInt);
        c.inst->outL[i] = sample * outputScale;
    }
}
