inline float cvToEnvelopeSeconds(float volts, float maxSeconds, bool log)
{
    float v = volts * kInvMaxVolts;
    if (v < 0.0f)
        v = 0.0f;
    if (v > 1.0f)
        v = 1.0f;
    if (log)
        return maxSeconds * powf(10.0f, 3.0f * (v - 1.0f));
