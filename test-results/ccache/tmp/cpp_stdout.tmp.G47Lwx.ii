        ctx.fmActive = fmActive;
        ctx.feedbackActive = feedbackActive;
        for (size_t voice = 0; voice < 6; ++voice)
            ctx.ratios[voice] = exp2f(kSuperSawCents[voice] * detune / 1200.0f);

        if (detune == 0.0f)
        {
            const uint32_t centerPhase = s.phaseGen.phaseInt();
