    const float zeroPointVolts = zeroPointFed ? portSample(inst, 3, 0) : s.zeroPoint;
    const float center = s.zeroPointFixed ? zeroPointVolts : halfSwing;




    const float phaseOffset = s.phaseOffsetDeg / 360.0f;
