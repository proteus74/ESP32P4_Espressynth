    case WaveType::Wavetable:
        break;
    }
}

inline void build(NodeInstance &inst, const WidgetParams &p)
{
    auto &s = inst.fmOsc;
    s.wave = p.waveType;
    s.tuneVolts = p.tuneVolts;
    s.amplitude = p.amplitude;
    s.gainCv = p.gain;
    s.fmIndexCv = p.fmIndex;
    s.feedbackCv = p.oscillatorFeedback;
    s.dutyCycleCv = p.dutyCycle;
    s.superSawDetuneCv = p.superSawDetune;
    s.superSawMixCv = p.superSawMix;
    s.morphCv = p.wavetableMorph;

    s.wavetableBank = ::wavetable::acquire(p.wavetableBank);

    s.gainSmooth.setCutoff(300.0f, static_cast<float>(synth::kSampleRate));
}

inline void destroy(NodeInstance &inst)
{
    ::wavetable::release(inst.fmOsc.wavetableBank);
    inst.fmOsc.wavetableBank = nullptr;
}

inline bool setParam(NodeInstance &inst, const char *name, float value)
{
    if (name == nullptr)
    {
        return false;
    }
    auto &s = inst.fmOsc;
    if (strcmp(name, "morph") == 0)
    {
        s.morphCv = value < 0.0f ? 0.0f : (value > cv::kMaxVolts ? cv::kMaxVolts : value);
        return true;
    }
    if (strcmp(name, "tune") == 0)
    {
        s.tuneVolts = value;
        return true;
    }
    if (strcmp(name, "amplitude") == 0)
    {
        s.amplitude = value;
        return true;
    }
    if (strcmp(name, "gain") == 0)
    {
        s.gainCv = value;
        return true;
    }
    if (strcmp(name, "fmIndex") == 0)
    {
        s.fmIndexCv = value;
        return true;
    }
    if (strcmp(name, "feedback") == 0)
    {
        s.feedbackCv = value;
        return true;
    }
    if (strcmp(name, "dutyCycle") == 0)
    {
        s.dutyCycleCv = value;
        return true;
    }
    if (strcmp(name, "superSawDetune") == 0)
    {
        s.superSawDetuneCv = value;
        return true;
    }
    if (strcmp(name, "superSawMix") == 0)
    {
        s.superSawMixCv = value;
        return true;
    }
    if (strcmp(name, "gate") == 0)
    {
        const bool gateNow = value > cv::kGateThresholdVolts;
        if (gateNow && !s.gatePrev)
        {
            s.phaseGen.resetPhase();
            for (uint32_t &phase : s.superSawSidePhase)
                phase = 0u;
            s.feedbackSample = 0.0f;
        }
        s.gatePrev = gateNow;
        return true;
    }
    return false;
}

inline void parsePreset(cJSON *p, WidgetParams &out)
{
    out.waveType = waveTypeFromString(presetparser::getString(p, "waveType", "sine"), true);


    out.tuneVolts = presetparser::getFloat(p, "tune", 5.0f);
    out.amplitude = presetparser::getFloat(p, "amplitude", 1.0f);
    out.gain = presetparser::getFloat(p, "gain", 10.0f);
    out.fmIndex = presetparser::getFloat(p, "fmIndex", 0.0f);
    out.oscillatorFeedback = presetparser::getFloat(p, "feedback", 0.0f);
    out.dutyCycle = presetparser::getFloat(p, "dutyCycle", 5.0f);
    out.superSawDetune = presetparser::getFloat(p, "superSawDetune", 5.0f);
    out.superSawMix = presetparser::getFloat(p, "superSawMix", 5.0f);


    out.wavetableMorph = presetparser::getFloat(p, "morph", 0.0f);
    out.wavetableBank = ::wavetable::parse(p != nullptr ? cJSON_GetObjectItemCaseSensitive(p, "wavetables") : nullptr,
                                           out.waveType == WaveType::Wavetable);
}

}
