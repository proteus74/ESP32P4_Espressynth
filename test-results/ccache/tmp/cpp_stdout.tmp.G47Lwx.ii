struct Event {};
using EventCallback = void (*)(const Event& event);

namespace {
inline EventCallback s_callback = nullptr;
inline TaskHandle_t s_debounce_task = nullptr;
constexpr uint32_t DEBOUNCE_MS = 50;



void __attribute__((section(".iram1" "." "43"))) gpio_isr_handler(void* ) {
    BaseType_t higher_priority_task_woken = ( ( BaseType_t ) 0 );
    vTaskGenericNotifyGiveFromISR( ( s_debounce_task ), ( ( 0 ) ), ( &higher_priority_task_woken ) );
    ({ if (higher_priority_task_woken == ( ( BaseType_t ) 1 )) { vPortYieldFromISR(); } });
}

void debounce_task(void* ) {
    while (true) {
        ulTaskGenericNotifyTake( ( ( 0 ) ), ( ( ( BaseType_t ) 1 ) ), ( (TickType_t) 0xffffffffUL ) );
        vTaskDelay(( ( TickType_t ) ( ( ( TickType_t ) ( DEBOUNCE_MS ) * ( TickType_t ) 1000 ) / ( TickType_t ) 1000U ) ));
        if (gpio_get_level(WM8960_PIN_BUTTON) != 0) continue;
        if (s_callback != nullptr) {
            const Event event{};
            s_callback(event);
        }
    }
}
}





inline void set_callback(EventCallback callback) {
    s_callback = callback;
}





