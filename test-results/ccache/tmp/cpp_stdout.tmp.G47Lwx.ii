    static __attribute__((section(".iram1" "." "22"))) float sampleAt(WaveType wave, uint32_t p, uint32_t dutyThresholdInt = 0x80000000u)
    {
        switch (wave)
        {
        case WaveType::Sine:
            return dsp::sineLookupInt(p);
        case WaveType::Square:
            return p < dutyThresholdInt ? 1.0f : -1.0f;
        case WaveType::Triangle:
