menu "Espressynth"

    menu "Board Configuration"

        choice BOARD_TARGET
            prompt "Target Board"
            default BOARD_JC8012P4A1
            help
                Select the target ESP32-P4 development board.

            config BOARD_JC8012P4A1
                bool "JC8012P4A1 Board (10.1\" 1280x800 MIPI DSI, C6 Hosted)"
                help
                    Board support for JC8012P4A1 development board.
                    Includes MIPI DSI display (JD9365), GSL3680 touch, ES8311 audio,
                    and ESP32-C6 hosted co-processor over SDIO.

            config BOARD_JC1060P470C_7_INCH
                bool "JC1060P470C 7\" Board (1024x600 MIPI DSI, C6 Hosted)"
                help
                    Board support for the Guition JC1060P470C 7-inch board
                    (JC-ESP32P4-M3 module). Includes MIPI DSI display (JD9165),
                    GT911 touch, ES8311 audio, RX8025T RTC, IP101 Ethernet,
                    MAX485 RS485 and an ESP32-C6 hosted co-processor over SDIO.

            config WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                bool "Waveshare ESP32-P4-WIFI6-DEV-KIT"
                select ESP32P4_SELECTS_REV_LESS_V3
                help
                    Board support for Waveshare ESP32-P4-WIFI6-DEV-KIT development board.
                    Includes ESP32-C6 Wi-Fi 6/BLE 5 co-processor via SDIO, ES8311 I2S Audio Codec,
                    100M Ethernet, TF Card slot, and MIPI DSI/CSI interfaces.
                    This board uses an ESP32-P4 v1.x and therefore requires the pre-v3
                    compatibility mode and a 360 MHz CPU clock.

            config BOARD_CROWPANEL_5INCH
                bool "Elecrow CrowPanel Advanced 5\" (800x480 RGB, NS4168, C6 Hosted)"
                select ESP32P4_SELECTS_REV_LESS_V3
                # LittleFS/NVS writes otherwise starve the RGB DMA ISR and the picture shifts.
                select LCD_RGB_ISR_IRAM_SAFE
                help
                    Board support for the Elecrow CrowPanel Advanced 5-inch ESP32-P4 HMI
                    display. Includes a 16-bit parallel RGB panel (800x480), GT911 touch,
                    an STC8H1K co-MCU on I2C (backlight PWM, touch reset, amp enable,
                    battery), NS4168 I2S class-D speaker amp, PDM microphone, TF card slot
                    and an ESP32-C6 hosted co-processor over SDIO.

            config BOARD_CUSTOM_P4
                bool "Custom ESP32-P4 Board"
                help
                    Define a custom pinout and configuration for your own ESP32-P4 board.
        endchoice

        # Board capabilities. Hidden (no prompt), so they always follow the selected
        # board. Features a board physically lacks depend on these and disappear from
        # menuconfig. Pins of fixed boards are prompt-less too ("int "..." if BOARD_CUSTOM_P4"):
        # a symbol without a visible prompt is recomputed from its default on every run,
        # so switching boards can never leave stale pins of the previous board behind.
        # Only the Custom board exposes everything.
        config BOARD_HAS_ETHERNET
            bool
            default y if BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD || BOARD_CUSTOM_P4

        config BOARD_HAS_ES8311
            bool
            default y if BOARD_JC8012P4A1 || BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD || BOARD_CUSTOM_P4

        # Panel connector accepts different displays (output type/size stay selectable).
        config BOARD_HAS_VARIABLE_DISPLAY
            bool
            default y if WAVESHARE_P4_WIFI_DEV_KIT_BOARD || BOARD_CUSTOM_P4

        if BOARD_JC8012P4A1
            config JC8012P4A1_PIN_LCD_RST
                int
                default 27

            config JC8012P4A1_PIN_BACKLIGHT
                int
                default 23
        endif

    if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
        menu "Waveshare ESP32-P4-WIFI6-DEV-KIT Settings"
            config WAVESHARE_P4_PIN_LCD_RST
                int "Panel reset GPIO (-1 to disable)"
                range -1 54
                default -1

            config WAVESHARE_P4_PIN_BACKLIGHT
                int "Backlight GPIO (-1 to disable)"
                range -1 54
                default -1
        endmenu
    endif

    if BOARD_CROWPANEL_5INCH
        menu "CrowPanel 5\" Settings"
            config CROWPANEL_STC8_I2C_ADDR
                hex "STC8H1K co-MCU I2C address"
                default 0x2F
                help
                    The on-board STC8H1K microcontroller (same I2C bus as the GT911 touch
                    controller) drives the LCD backlight PWM, the touch reset line, the
                    NS4168 amp shutdown line and reports battery/charge state.

            config CROWPANEL_BACKLIGHT_PWM_MAX
                int "STC8 backlight PWM value for 100% brightness"
                range 1 255
                default 100
                help
                    Full-scale value written to the STC8 PWM register. The vendor firmware
                    does not document the range; 100 = percent is the assumption.

            config CROWPANEL_BATTERY_STATUS
                bool "Show the battery status (STC8 co-MCU) in the web UI"
                default y
                help
                    Reads voltage, charge level and charging state of the battery on the
                    PH2.0 battery connector from the STC8 co-MCU and shows it next to the
                    audio button in the web UI header (GET /api/battery). Turn off if no
                    battery is ever connected.

            config CROWPANEL_AUDIO_SD_ACTIVE_HIGH
                bool "NS4168 amp enabled when STC8 AUDIO_SD output is high"
                default n
                help
                    AUDIO_SD is the amplifier's shutdown input: Elecrow's vendor code drives it
                    low to enable the amp, so the default is off (= enable with a low level).
        endmenu
    endif

    if BOARD_JC1060P470C_7_INCH
            menu "JC1060P470C Settings"
                config JC1060P470C_PIN_LCD_RST
                    int "JD9165 panel reset GPIO (-1 to disable)"
                    default 27
                    range -1 54
                    help
                        The vendor demo bundle is inconsistent about this line: Guition's own
                        board file (xiaozhi guition-jc1060p470-new) drives GPIO27, while the
                        ESP32-P4 BSP copy shipped in the same bundle uses GPIO0. GPIO27 is
                        also the RS485 receive line on the RS485-equipped variants. If the
                        panel stays dark, try 0 here, or -1 to leave the panel reset
                        untouched (the panel then relies on its power-on reset).
            endmenu
        endif

        if BOARD_CUSTOM_P4
            menu "Custom Board Settings"
                config CUSTOM_BOARD_NAME
                    string "Board Name"
                    default "Custom ESP32-P4"

                config CUSTOM_DISPLAY_WIDTH
                    int "Display Width (px)"
                    default 800

                config CUSTOM_DISPLAY_HEIGHT
                    int "Display Height (px)"
                    default 480
            endmenu
        endif


        choice APP_P4_CHIP_REV
            prompt "ESP32-P4 Chip Version"
            default APP_P4_CHIP_REV_V3
            help
                Silicon revision of the ESP32-P4 on the board (printed by esptool as
                "Chip type: ESP32-P4 (revision vX.Y)"). Revisions <3.0 and >=3.0 are mutually
                exclusive: a binary built for one is refused by the bootloader/flasher on the other.

            config APP_P4_CHIP_REV_V1
                bool "v1.x (also 0.x)"
                select ESP32P4_SELECTS_REV_LESS_V3
            config APP_P4_CHIP_REV_V3
                bool "v3.x"
        endchoice
    endmenu

    menu "Features"


    config APP_ENABLE_SYNTH
        bool
        default y

    menu "I2C Subsystem"

        config APP_ENABLE_I2C
            bool "Enable I2C Subsystem" if BOARD_CUSTOM_P4
            default y
            help
                Master switch for the ESP32-P4's I2C controllers (I2C0/I2C1),
                used by onboard peripherals such as the ES8311/WM8960 audio
                codecs. Disable to compile out I2C entirely.

        if APP_ENABLE_I2C

            config APP_ENABLE_I2C0
                bool "Enable I2C Port 0" if BOARD_CUSTOM_P4
                default y
                help
                    Primary I2C bus. Most boards' onboard peripherals (audio
                    codec control, touch, RTC) are wired here by default.

            if APP_ENABLE_I2C0
                config I2C0_PIN_SDA
                    int "I2C0 SDA GPIO" if BOARD_CUSTOM_P4
                    default 45 if BOARD_CROWPANEL_5INCH
                    default 7

                config I2C0_PIN_SCL
                    int "I2C0 SCL GPIO" if BOARD_CUSTOM_P4
                    default 46 if BOARD_CROWPANEL_5INCH
                    default 8

                choice APP_I2C0_SPEED
                    prompt "I2C0 Bus Speed"
                    default APP_I2C0_SPEED_100KHZ if BOARD_CROWPANEL_5INCH
                    default APP_I2C0_SPEED_50KHZ
                    help
                        Clock used by every device attached to I2C0. All
                        devices and the physical bus must support the selected
                        speed.

                    config APP_I2C0_SPEED_50KHZ
                        bool "50 kHz"
                    config APP_I2C0_SPEED_100KHZ
                        bool "100 kHz"
                    config APP_I2C0_SPEED_200KHZ
                        bool "200 kHz"
                    config APP_I2C0_SPEED_400KHZ
                        bool "400 kHz"
                    config APP_I2C0_SPEED_1MHZ
                        bool "1 MHz"
                endchoice
            endif

            config APP_I2C0_SPEED_HZ
                int
                default 50000 if APP_I2C0_SPEED_50KHZ
                default 100000 if APP_I2C0_SPEED_100KHZ
                default 200000 if APP_I2C0_SPEED_200KHZ
                default 400000 if APP_I2C0_SPEED_400KHZ
                default 1000000 if APP_I2C0_SPEED_1MHZ
                default 50000

            config APP_ENABLE_I2C1
                bool "Enable I2C Port 1"
                default n
                help
                    Optional second, independent I2C bus - e.g. to wire a
                    WM8960 codec to different pins than the board's default
                    I2C bus.

            if APP_ENABLE_I2C1
                config I2C1_PIN_SDA
                    int "I2C1 SDA GPIO"
                    default -1

                config I2C1_PIN_SCL
                    int "I2C1 SCL GPIO"
                    default -1

                choice APP_I2C1_SPEED
                    prompt "I2C1 Bus Speed"
                    default APP_I2C1_SPEED_50KHZ
                    help
                        Clock used by every device attached to I2C1. All
                        devices and the physical bus must support the selected
                        speed.

                    config APP_I2C1_SPEED_50KHZ
                        bool "50 kHz"
                    config APP_I2C1_SPEED_100KHZ
                        bool "100 kHz"
                    config APP_I2C1_SPEED_200KHZ
                        bool "200 kHz"
                    config APP_I2C1_SPEED_400KHZ
                        bool "400 kHz"
                    config APP_I2C1_SPEED_1MHZ
                        bool "1 MHz"
                endchoice
            endif

            config APP_I2C1_SPEED_HZ
                int
                default 50000 if APP_I2C1_SPEED_50KHZ
                default 100000 if APP_I2C1_SPEED_100KHZ
                default 200000 if APP_I2C1_SPEED_200KHZ
                default 400000 if APP_I2C1_SPEED_400KHZ
                default 1000000 if APP_I2C1_SPEED_1MHZ
                default 50000

        endif

    endmenu

    menu "External Hardware"

        config APP_ENABLE_WS2812
            bool "Enable WS2812 LED System"
            default y
            help
                Enables the WS2812 LED string driver and its update task.
                The GPIO and LED count are configured at runtime in Settings.
                Disable to remove the driver and pixel buffer from the firmware.
                Saved LED string settings are retained for later re-enabling.

        config APP_ADS1115_SUPPORT
            bool "DFRobot ADS1115 0-10V Support (external CV ADC)"
            default n
            depends on APP_ENABLE_I2C
            help
                Enables two-channel CV input support. At startup, every
                enabled I2C bus is searched for DFRobot DFR1184 modules at
                addresses 0x48-0x4B.

        if APP_ADS1115_SUPPORT
            config APP_ADS1115_POLL_RATE_HZ
                int "ADS1115 target polls per second per active channel"
                range 1 125
                default 20
                help
                    Scheduler target from 1 to 125 polls per second per active
                    channel. The DFRobot DFR1184 controller exposes channel
                    selection and voltage data, but no command for configuring
                    the internal ADS1115 sample rate.
        endif

        config APP_GP8413_SUPPORT
            bool "DFRobot GP8413 Support (2Ch 15 Bit DAC)"
            default n
            depends on APP_ENABLE_I2C
            help
                Enables two-channel 0-10V CV output support. At startup,
                every enabled I2C bus is searched for GP8413 modules at
                addresses 0x58-0x5F.

        config APP_ENABLE_GPIO_INPUT
            bool "Enable GPIO Digital Input"
            default n
            help
                Enables user-configurable GPIO pins as Digital Input widgets
                (optional pull-up/pull-down). Which physical pins are used is
                chosen at runtime in the Settings dialog, not here - this
                flag only compiles the capability in.

        config APP_ENABLE_GPIO_OUTPUTS
            bool "Enable GPIO Digital Output"
            default n
            help
                Enables user-configurable GPIO pins as Digital Output
                widgets. Which physical pins are used is chosen at runtime
                in the Settings dialog, not here - this flag only compiles
                the capability in.

    endmenu

    menu "Audio Subsystem"

        config APP_ENABLE_AUDIO
            bool "Enable Audio Subsystem"
            default y if !BOARD_CUSTOM_P4
            default n
            help
                Master switch for all audio functionality: the onboard ES8311
                codec, the generic WM8960 codec, and/or the USB Audio Class 2.0
                (UAC2) sound card. All audio paths run at a fixed 44.1 kHz.
                Disable to compile out all audio support.

        if APP_ENABLE_AUDIO

            config ONBOARD_AUDIO_NS4168
                bool "Enable NS4168 I2S Class-D Amplifier (no codec, no I2C)"
                default y if BOARD_CROWPANEL_5INCH
                default n
                help
                    NS4168 mono class-D speaker amp (onboard on the Elecrow CrowPanel
                    Advanced boards, or any NS4168 breakout): plain I2S input
                    (BCLK/LRCK/DOUT, no MCLK, no register interface). It is its own
                    output sink with its own "NS4168-Out" widget in the web UI and can
                    run alongside the ES8311 and/or WM8960 codecs on a different I2S
                    port. Volume and mute are applied in software by the synth engine.

            if ONBOARD_AUDIO_NS4168
                config ONBOARD_AUDIO_NS4168_I2S_PORT
                    int "I2S Port Number (0-2)" if !BOARD_CROWPANEL_5INCH
                    range 0 2
                    default 1 if BOARD_CROWPANEL_5INCH
                    default 0
                    help
                        Selects which I2S peripheral instance (I2S0, I2S1 or I2S2)
                        drives the NS4168. Must differ from the ES8311/WM8960 I2S
                        port if those codecs are enabled too (checked at compile
                        time).

                config ONBOARD_AUDIO_NS4168_PIN_BCLK
                    int "I2S BCLK GPIO" if !BOARD_CROWPANEL_5INCH
                    range -1 54
                    default 22 if BOARD_CROWPANEL_5INCH
                    default -1

                config ONBOARD_AUDIO_NS4168_PIN_LRCK
                    int "I2S LRCLK (word-select) GPIO" if !BOARD_CROWPANEL_5INCH
                    range -1 54
                    default 21 if BOARD_CROWPANEL_5INCH
                    default -1

                config ONBOARD_AUDIO_NS4168_PIN_DOUT
                    int "I2S DOUT GPIO (ESP32 -> NS4168 SDATA)" if !BOARD_CROWPANEL_5INCH
                    range -1 54
                    default 23 if BOARD_CROWPANEL_5INCH
                    default -1

                config ONBOARD_AUDIO_NS4168_PIN_CTRL
                    int "CTRL (shutdown) GPIO, driven high to enable the amp (-1 = not wired)" if !BOARD_CROWPANEL_5INCH
                    range -1 54
                    default -1
                    help
                        Optional GPIO wired to the NS4168 CTRL pin (low = shutdown).
                        Leave at -1 if CTRL is hard-wired. On the CrowPanel the amp
                        is switched by the STC8 co-MCU instead (see
                        CROWPANEL_AUDIO_SD_ACTIVE_HIGH), so this stays -1 there.
            endif

            config ONBOARD_AUDIO_PDM_MIC
                bool "Enable PDM microphone input (Mic-In widget)"
                default y if BOARD_CROWPANEL_5INCH
                default n
                help
                    Onboard PDM MEMS microphone (CrowPanel Advanced: MMICT5838 on
                    GPIO24/25, or any PDM mic) as the source of the "Mic-In" widget
                    under External Audio. The ESP32-P4 receives PDM on I2S0 only, so
                    every other I2S audio device must use port 1 or 2 (checked at
                    compile time).

            if ONBOARD_AUDIO_PDM_MIC
                config ONBOARD_AUDIO_PDM_MIC_PIN_CLK
                    int "PDM CLK GPIO" if !BOARD_CROWPANEL_5INCH
                    range -1 54
                    default 24 if BOARD_CROWPANEL_5INCH
                    default -1

                config ONBOARD_AUDIO_PDM_MIC_PIN_DIN
                    int "PDM DATA GPIO" if !BOARD_CROWPANEL_5INCH
                    range -1 54
                    default 25 if BOARD_CROWPANEL_5INCH
                    default -1

                config ONBOARD_AUDIO_PDM_MIC_GAIN
                    int "Digital gain (x)"
                    range 1 64
                    default 8
                    help
                        Multiplier applied to the PCM samples before they reach the
                        Mic-In widget (a bare MEMS mic is quiet). Patch a Gain/VCA
                        widget behind Mic-In for finer, live adjustment.
            endif

            config ONBOARD_AUDIO_ES8311
                bool "Enable ES8311 Audio Codec (I2S + I2C)"
                depends on BOARD_HAS_ES8311
                default y if BOARD_JC8012P4A1 || BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                default n
                help
                    ES8311 mono audio codec support, e.g. the one found onboard the
                    Waveshare ESP32-P4-WIFI6-DEV-KIT and JC8012P4A1, or an external
                    ES8311 breakout wired to a CONFIG_BOARD_CUSTOM_P4 board. The codec
                    is driven via I2S (audio data) and I2C (register control) using
                    the esp_codec_dev component. Pins below default to the selected
                    board's onboard wiring where one exists; override for a different
                    wiring.

            if ONBOARD_AUDIO_ES8311
                config ONBOARD_AUDIO_ES8311_I2S_PORT
                    int "I2S Port Number (0-2)" if BOARD_CUSTOM_P4
                    range 0 2
                    default 0
                    help
                        Selects which I2S peripheral instance (I2S0, I2S1 or I2S2)
                        drives the ES8311 codec's audio data lines
                        (MCLK/BCLK/LRCK/DOUT/DIN). Must differ from
                        ONBOARD_AUDIO_WM8960_I2S_PORT if both codecs are enabled.

                config ONBOARD_AUDIO_ES8311_I2C_PORT
                    int "I2C Port Number (0-1)" if BOARD_CUSTOM_P4
                    range 0 1
                    default 0
                    help
                        Selects which I2C bus (see "I2C Subsystem" above) carries
                        the ES8311's register control interface. That port must
                        be enabled there, or ES8311 init fails at runtime.

                config ONBOARD_AUDIO_ES8311_PIN_MCLK
                    int "I2S MCLK GPIO (-1 to disable)" if BOARD_CUSTOM_P4
                    default 13 if BOARD_JC8012P4A1
                    default 13 if BOARD_JC1060P470C_7_INCH
                    default 13 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                    default -1
                    help
                        ES8311 master clock input. -1 (GPIO_NUM_NC) if the codec
                        derives its clock without an explicit MCLK line.

                config ONBOARD_AUDIO_ES8311_PIN_BCLK
                    int "I2S BCLK GPIO" if BOARD_CUSTOM_P4
                    default 12 if BOARD_JC8012P4A1
                    default 12 if BOARD_JC1060P470C_7_INCH
                    default 12 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                    default -1
                    help
                        -1 (GPIO_NUM_NC) leaves the codec disabled at runtime.

                config ONBOARD_AUDIO_ES8311_PIN_LRCK
                    int "I2S LRCLK (word-select) GPIO" if BOARD_CUSTOM_P4
                    default 10 if BOARD_JC8012P4A1
                    default 10 if BOARD_JC1060P470C_7_INCH
                    default 10 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                    default -1

                config ONBOARD_AUDIO_ES8311_PIN_DOUT
                    int "I2S DOUT GPIO (ESP32 -> ES8311 DAC, speaker data)" if BOARD_CUSTOM_P4
                    default 9 if BOARD_JC8012P4A1
                    default 9 if BOARD_JC1060P470C_7_INCH
                    default 9 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                    default -1

                config ONBOARD_AUDIO_ES8311_PIN_DIN
                    int "I2S DIN GPIO (ES8311 ADC -> ESP32, microphone data)" if BOARD_CUSTOM_P4
                    default 11 if BOARD_JC8012P4A1
                    default 48 if BOARD_JC1060P470C_7_INCH
                    default 11 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                    default -1
                    help
                        Set to -1 for playback-only operation.

                config ONBOARD_AUDIO_ES8311_PIN_PA
                    int "PA enable GPIO, active high (-1 to disable)" if BOARD_CUSTOM_P4
                    default 20 if BOARD_JC8012P4A1
                    default 11 if BOARD_JC1060P470C_7_INCH
                    default 53 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                    default -1
            endif

            config ONBOARD_AUDIO_WM8960
                bool "Enable WM8960 Audio Codec (I2S + I2C)"
                default n
                help
                    Generic WM8960 stereo codec support (e.g. a Waveshare WM8960
                    Audio HAT on a Raspberry-Pi-compatible 40-pin header, or any
                    other WM8960 wiring). Register control uses I2C (shared board
                    I2C bus, address 0x1A); audio data uses I2S on the four pins
                    configured below. Can be enabled alongside the onboard ES8311
                    codec - just pick a different I2S port and non-conflicting
                    pins (checked at compile time against the current board's
                    reserved pins).

            if ONBOARD_AUDIO_WM8960
                config ONBOARD_AUDIO_WM8960_I2S_PORT
                    int "I2S Port Number (0-2)"
                    range 0 2
                    default 1
                    help
                        Selects which I2S peripheral instance drives the WM8960's
                        audio data lines. Must differ from
                        ONBOARD_AUDIO_ES8311_I2S_PORT if both codecs are enabled
                        (the I2S driver rejects a duplicate claim at runtime if
                        not).

                config ONBOARD_AUDIO_WM8960_I2C_PORT
                    int "I2C Port Number (0-1)"
                    range 0 1
                    default 0
                    help
                        Selects which I2C bus (see "I2C Subsystem" above) drives
                        the WM8960's register control interface. That port must
                        be enabled there, or WM8960 init fails at runtime.

                config ONBOARD_AUDIO_WM8960_PIN_BCLK
                    int "I2S BCLK GPIO"
                    default -1
                    help
                        Bit clock, driven by the ESP32-P4 (WM8960 runs as I2S
                        peripheral). -1 (GPIO_NUM_NC) leaves the codec disabled
                        at runtime.

                config ONBOARD_AUDIO_WM8960_PIN_LRCK
                    int "I2S LRCLK (word-select) GPIO"
                    default -1

                config ONBOARD_AUDIO_WM8960_PIN_DIN
                    int "I2S DIN GPIO (WM8960 ADC -> ESP32, microphone data)"
                    default -1
                    help
                        WM8960 microphone/ADC data input. Set to -1 for playback-only
                        operation. GPIO26 and GPIO27 are reserved for USB Device D-/D+.

                config ONBOARD_AUDIO_WM8960_PIN_DOUT
                    int "I2S DOUT GPIO (ESP32 -> WM8960 DAC, speaker data)"
                    default -1

                config ONBOARD_AUDIO_WM8960_PIN_BUTTON
                    int "Onboard button GPIO (-1 to disable)"
                    default -1
                    help
                        Active-low push-button on the WM8960 board/HAT, if
                        present and wired. -1 (GPIO_NUM_NC) disables the button
                        feature entirely.
            endif

            config AUDIO_I2S_DMA_DESC_NUM
                int "I2S DMA descriptor count (onboard codecs)"
                range 2 16
                default 3
                depends on ONBOARD_AUDIO_ES8311 || ONBOARD_AUDIO_NS4168 || ONBOARD_AUDIO_WM8960 || ONBOARD_AUDIO_PDM_MIC
                help
                    Part 1 of the I2S output buffer's size, shared by every
                    onboard I2S codec (ES8311 and/or WM8960 -- NOT the USB
                    UAC2 sound card, which has its own separate buffering).

                    Background: the I2S peripheral streams audio out of RAM
                    via DMA (Direct Memory Access) without CPU involvement
                    per sample. The driver organizes that RAM as a ring of
                    N fixed-size chunks ("descriptors"); the DMA hardware
                    walks the ring continuously while the app keeps writing
                    fresh audio into the chunk behind it. This option sets
                    N, i.e. how many chunks the ring has. AUDIO_I2S_DMA_FRAME_NUM
                    below sets how many audio frames (see its help) fit in
                    *each* chunk -- the two multiply together into the
                    ring's total capacity.

                    Formula:
                        total_frames = AUDIO_I2S_DMA_DESC_NUM * AUDIO_I2S_DMA_FRAME_NUM
                        latency_ms   = total_frames / 44100 * 1000

                    Default 6 * 240 = 1440 frames = 1440 / 44100 * 1000
                    ~= 32.6 ms. That is roughly how long it takes a sample
                    written to the buffer right now to actually reach the
                    speaker -- the I2S half of the app's total output
                    latency (the synth engine adds its own share, see
                    AUDIO_SYNTH_BLOCK_SIZE below).

                    Raising DESC_NUM (or FRAME_NUM) grows the ring, buying
                    more headroom against a writer stall -- e.g. the "tone"
                    CLI command or any other task briefly starving the audio
                    writer of CPU time -- at the cost of latency. A stall
                    longer than the ring's total playtime underruns it, and
                    auto_clear_after_cb (es8311_manager.hpp /
                    wm8960_manager.hpp) fills the gap with silence instead of
                    repeating stale audio -- audible as a click/pop either
                    way. Lowering DESC_NUM (or FRAME_NUM) shrinks the ring
                    for less latency, at the cost of less stall headroom.
                    Needs at least 2 descriptors for the driver to have a
                    "currently playing" chunk and a "being filled next" chunk
                    at all times.

            config AUDIO_I2S_DMA_FRAME_NUM
                int "I2S DMA frames per descriptor (onboard codecs)"
                range 32 960
                default 128
                depends on ONBOARD_AUDIO_ES8311 || ONBOARD_AUDIO_NS4168 || ONBOARD_AUDIO_WM8960 || ONBOARD_AUDIO_PDM_MIC
                help
                    Part 2 of the I2S output buffer's size -- see
                    AUDIO_I2S_DMA_DESC_NUM above for the full explanation,
                    the ring-buffer background, and the latency formula.

                    "Frame" here means one sample per channel, for both
                    channels at once (this project is fixed at 16-bit
                    stereo): 1 frame = 2 samples = 4 bytes. This option sets
                    how many such frames fit in each of the
                    AUDIO_I2S_DMA_DESC_NUM ring chunks, i.e. how large a
                    single DMA transfer is.

                    Default 128 frames/descriptor * 3 descriptors = 384
                    frames total ~= 8.7 ms @ 44.1kHz (with the default 128
                    render block). Measured on the CrowPanel with a 5-voice
                    chord pattern plus parallel web downloads: no DMA underrun
                    down to 2 descriptors (5.8 ms), but render spikes reached
                    4.3 ms, so 3 keeps ~2x headroom. The old 6 x 240 (32.6 ms)
                    never underran either and just cost ~25 ms of latency.
                    The upper end of the
                    range (960) is headroom under the I2S driver's hard
                    per-descriptor buffer ceiling (4095 bytes,
                    I2S_DMA_BUFFER_MAX_SIZE in esp_driver_i2s/i2s_common.c)
                    -- at 4 bytes/frame that ceiling is 1023 frames, so 960
                    stays safely under it with room for the driver's own
                    alignment rounding. Not a value chosen for its latency.

            config USB_DEV_ENABLE_UAC2
                bool "Enable USB Sound Card (UAC2, via USB Device Composite)"
                default y
                depends on APP_ENABLE_USB_DEVICE
                help
                    Exposes a USB Audio Class 2.0 (UAC2) sound card with 2-channel
                    (stereo) speaker output and 2-channel (stereo) microphone input,
                    as part of the composite USB device. Requires "Enable USB 1.1
                    Device Mode" above to be enabled. Fixed at 44.1 kHz.

        endif

    endmenu

    menu "Synth Engine"

        config AUDIO_SYNTH_MAX_VOICES
            int "Maximum voices"
            range 1 32
            default 16
            help
                Compile-time ceiling for polyphonic graph expansion.
                Presets may request fewer voices, and the runtime builder
                can reduce this count further when internal RAM does not
                fit. Higher values increase Graph metadata in PSRAM and
                per-voice node buffers/state, primarily in internal RAM.

        config AUDIO_SYNTH_BLOCK_SIZE
            int "Render Block Size"
            range 16 1024
            default 128
            help
                Number of samples rendered per node-graph pass. At
                44.1 kHz, 128 samples correspond to about 2.9 ms.
                Smaller blocks reduce latency but increase scheduling
                and graph-walk overhead.

    endmenu

    menu "Display Output"

        choice APP_DISPLAY_OUTPUT
            prompt "Output Type"
            default APP_DISPLAY_OUTPUT_MIPI if BOARD_JC8012P4A1 || BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD
            default APP_DISPLAY_OUTPUT_RGB if BOARD_CROWPANEL_5INCH
            default APP_DISPLAY_OUTPUT_NONE

            # Fixed-panel boards only offer their own panel type. (A choice needs a visible
            # prompt to keep a selection, so the members are restricted instead.)
            config APP_DISPLAY_OUTPUT_NONE
                bool "NONE"
                depends on BOARD_HAS_VARIABLE_DISPLAY
            config APP_DISPLAY_OUTPUT_MIPI
                bool "MIPI"
                depends on BOARD_HAS_VARIABLE_DISPLAY || BOARD_JC8012P4A1 || BOARD_JC1060P470C_7_INCH
            config APP_DISPLAY_OUTPUT_SPI
                bool "SPI"
                depends on BOARD_HAS_VARIABLE_DISPLAY
            config APP_DISPLAY_OUTPUT_RGB
                bool "RGB (parallel, 16-bit)"
                depends on BOARD_CUSTOM_P4 || BOARD_CROWPANEL_5INCH
        endchoice

        config APP_ENABLE_MIPI_DSI
            bool
            default y if APP_DISPLAY_OUTPUT_MIPI

        config APP_DISPLAY_WIDTH
            int "Display Width (px)" if BOARD_HAS_VARIABLE_DISPLAY
            range 1 4096
            default 240 if APP_DISPLAY_OUTPUT_SPI
            default 1280 if BOARD_JC8012P4A1
            default 1024 if BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD
            default CUSTOM_DISPLAY_WIDTH if BOARD_CUSTOM_P4
            default 800

        config APP_DISPLAY_HEIGHT
            int "Display Height (px)" if BOARD_HAS_VARIABLE_DISPLAY
            range 1 4096
            default 320 if APP_DISPLAY_OUTPUT_SPI
            default 800 if BOARD_JC8012P4A1
            default 600 if BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD
            default CUSTOM_DISPLAY_HEIGHT if BOARD_CUSTOM_P4
            default 480

        choice APP_UI_LAYOUT
            prompt "EEZ UI layout"
            default APP_UI_LAYOUT_800_480 if BOARD_CROWPANEL_5INCH
            default APP_UI_LAYOUT_1280_800 if BOARD_JC8012P4A1
            default APP_UI_LAYOUT_1024_600
            help
                Which EEZ Studio UI export (eezstudio/src/ui/<layout>) is compiled in.
                Only the selected one is built. Defaults follow the board's panel.

            config APP_UI_LAYOUT_1024_600
                bool "1024x600 (eezstudio/src/ui/1024_800)"
                depends on BOARD_HAS_VARIABLE_DISPLAY || !(BOARD_CROWPANEL_5INCH || BOARD_JC8012P4A1)
            config APP_UI_LAYOUT_1280_800
                bool "1280x800 (eezstudio/src/ui/1280_800)"
                depends on BOARD_HAS_VARIABLE_DISPLAY || BOARD_JC8012P4A1
            config APP_UI_LAYOUT_800_480
                bool "800x480 (eezstudio/src/ui/800_480)"
                depends on BOARD_HAS_VARIABLE_DISPLAY || BOARD_CROWPANEL_5INCH
        endchoice

        if APP_DISPLAY_OUTPUT_MIPI
            choice APP_DISPLAY_MIPI_TYPE
                prompt "Display Type"
                default APP_DISPLAY_MIPI_JD9165 if BOARD_JC1060P470C_7_INCH
                default APP_DISPLAY_MIPI_JD9365

                config APP_DISPLAY_MIPI_JD9165
                    bool "JD9165"
                    depends on BOARD_HAS_VARIABLE_DISPLAY || BOARD_JC1060P470C_7_INCH
                config APP_DISPLAY_MIPI_JD9365
                    bool "JD9365"
                    depends on BOARD_HAS_VARIABLE_DISPLAY || BOARD_JC8012P4A1
            endchoice
        endif

        if APP_DISPLAY_OUTPUT_SPI
            choice APP_DISPLAY_SPI_TYPE
                prompt "Display Type"
                default APP_DISPLAY_SPI_ST7789

                config APP_DISPLAY_SPI_ST7789
                    bool "ST7789"
                config APP_DISPLAY_SPI_ILI9341
                    bool "ILI9341"
            endchoice

            config APP_DISPLAY_SPI_PIN_CLK
                int "GPIO SPI CLK (-1 = disabled)"
                range -1 54
                default -1

            config APP_DISPLAY_SPI_PIN_MISO
                int "GPIO SPI MISO (-1 = disabled)"
                range -1 54
                default -1

            config APP_DISPLAY_SPI_PIN_MOSI
                int "GPIO SPI MOSI (-1 = disabled)"
                range -1 54
                default -1

            config APP_DISPLAY_SPI_PIN_DC
                int "GPIO SPI D/C (-1 = disabled)"
                range -1 54
                default -1

            config APP_DISPLAY_SPI_PIN_CS
                int "GPIO SPI CS (-1 = disabled)"
                range -1 54
                default -1

            config APP_DISPLAY_SPI_PIN_RESET
                int "GPIO SPI RESET (-1 = disabled)"
                range -1 54
                default -1

            config APP_DISPLAY_SPI_PIN_BACKLIGHT
                int "GPIO SPI BACKLIGHT (-1 = disabled)"
                range -1 54
                default -1

        endif

        config APP_ENABLE_LVGL
            bool "Enable LVGL GUI Engine"
            default y
            depends on !APP_DISPLAY_OUTPUT_NONE
            depends on !APP_DISPLAY_OUTPUT_SPI || APP_DISPLAY_SPI_PIN_CLK >= 0
            help
                Enables LVGL graphics library and display rendering pipeline.

        config APP_ENABLE_SSD1306
            bool "Enable I2C SSD1306 Output"
            default n
            depends on APP_ENABLE_I2C && (APP_ENABLE_I2C0 || APP_ENABLE_I2C1)

        if APP_ENABLE_SSD1306
            config APP_SSD1306_I2C_PORT
                int "I2C Port Number (0-1)"
                range 0 0 if !APP_ENABLE_I2C1
                range 1 1 if !APP_ENABLE_I2C0
                range 0 1
                default 0 if APP_ENABLE_I2C0
                default 1

            choice APP_SSD1306_SIZE
                prompt "Display Size"
                default APP_SSD1306_128X64

                config APP_SSD1306_128X64
                    bool "128x64"
                config APP_SSD1306_128X32
                    bool "128x32"
                config APP_SSD1306_64X48
                    bool "64x48"
            endchoice

            config APP_SSD1306_WIDTH
                int
                default 64 if APP_SSD1306_64X48
                default 128

            config APP_SSD1306_HEIGHT
                int
                default 32 if APP_SSD1306_128X32
                default 48 if APP_SSD1306_64X48
                default 64
        endif

    endmenu

    menu "USB"

        config APP_ENABLE_USB_HOST
            bool "Enable TinyUSB Host & USB Hub Support"
            default y
            help
                Enables USB Host stack via TinyUSB and
                on-board USB Hub power management.

        if APP_ENABLE_USB_HOST
            config APP_ENABLE_USB_HUB_4PORT
                bool "Enable On-Board 4-Port USB Hub Support"
                default y if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                default n
                depends on WAVESHARE_P4_WIFI_DEV_KIT_BOARD
                help
                    Enables power switching and downstream port management for the on-board
                    4-port USB Hub. Only the Waveshare ESP32-P4-WIFI6-DEV-KIT has one (see
                    HAS_4PORT_USB_HUB in main/boards/*.hpp) -- not selectable for other boards.

            menu "Enabled USB Host Classes"
                config USB_HOST_CLASS_MIDI
                    bool "MIDI (USB MIDI Keyboards / Controllers / Synthesizers)"
                    default y

                config USB_HOST_CLASS_HID
                    bool "HID (Keyboard / Mouse)"
                    default y

                config USB_HOST_CLASS_MSC
                    bool "MSC (USB Flash Drive / Mass Storage)"
                    default n

                config USB_HOST_CLASS_CDC
                    bool "CDC-ACM (Virtual COM / Serial Devices)"
                    default n

                help
                    Select all USB classes that may be used concurrently.
            endmenu
        endif

        config APP_ENABLE_USB_DEVICE
            bool "Enable USB 1.1 Device Mode (USB-Serial-JTAG port as Custom Device)"
            default n
            help
                Reconfigures the secondary USB 1.1 Full-Speed port (USB1 / Serial-JTAG port)
                as a TinyUSB Device (CDC Serial, MIDI, Keyboard/Mouse HID, Mass Storage, DFU).

        if APP_ENABLE_USB_DEVICE
            menu "USB Device Configuration (VID/PID & Descriptors)"

                config USB_DEV_VID
                    hex "Vendor ID (VID)"
                    default 0x303A
                    help
                        USB Vendor ID (default is 0x303A for Espressif).

                config USB_DEV_PID
                    hex "Product ID (PID)"
                    default 0x4002
                    help
                        USB Product ID.

                config USB_DEV_MANUFACTURER
                    string "Manufacturer Name"
                    default "JoLaBI"

                config USB_DEV_PRODUCT_NAME
                    string "Product Name"
                    default "Synth"

                config USB_DEV_SERIAL_NUMBER
                    string "Serial Number"
                    default "123456"

                menu "Enabled USB Device Classes (Composite Device)"

                    config USB_DEV_ENABLE_CDC
                        bool "Enable CDC-ACM (Virtual Serial / COM Port)"
                        default y
                        help
                            Exposes a Virtual COM Port over USB.

                    config USB_DEV_ENABLE_MIDI
                        bool "Enable USB MIDI (Musical Instrument Device)"
                        default y
                        help
                            Exposes a standard USB MIDI IN/OUT streaming interface.

                    comment "USB Sound Card (UAC2) moved to Espressynth > Features > Audio Subsystem"

                    config USB_DEV_ENABLE_HID_KEYBOARD
                        bool "Enable HID Keyboard"
                        default n
                        help
                            Enables USB Human Interface Device (Keyboard emulation).

                    config USB_DEV_ENABLE_HID_MOUSE
                        bool "Enable HID Mouse"
                        default n
                        help
                            Enables USB Human Interface Device (Mouse emulation).

                    config USB_DEV_ENABLE_HID_GAMEPAD
                        bool "Enable HID Gamepad / Joystick"
                        default n
                        help
                            Enables Gamepad/Joystick input device emulation.

                    config USB_DEV_ENABLE_MSC
                        bool "Enable MSC (Mass Storage Device / Flash Drive)"
                        default n
                        help
                            Exposes on-board storage (RAM/Flash/SD-Card) as a USB Flash Drive to the PC.

                    config USB_DEV_ENABLE_DFU
                        bool "Enable DFU (Device Firmware Upgrade)"
                        default n
                        help
                            Allows flashing firmware over USB DFU protocol.

                endmenu

            endmenu
        endif

    endmenu

    menu "MIDI"

        config APP_MIDI_CC_FEEDBACK_OUT
            bool "Send CC feedback to connected MIDI controllers (USB host / BLE-MIDI)"
            default n
            depends on (APP_ENABLE_USB_HOST && USB_HOST_CLASS_MIDI) || (APP_ENABLE_BLUETOOTH && BLE_ENABLE_MIDI_HOST)
            help
                Mirrors MIDI-learned Knob/Button/tempo values back to connected MIDI
                controllers as Control Change messages (so motorized faders / LED rings
                follow changes made from the browser or touch display). Disabled by
                default: some keyboards crash when they receive CC messages.

    endmenu

    menu "ESP32-C6 Host Co Processor"

        config APP_ENABLE_HOSTED_COPROCESSOR
            bool "Enable Host Processor (ESP32-C6 / SDIO)" if BOARD_CUSTOM_P4
            default y if BOARD_JC8012P4A1 || BOARD_JC1060P470C_7_INCH || WAVESHARE_P4_WIFI_DEV_KIT_BOARD || BOARD_CROWPANEL_5INCH
            default n
            help
                Confirms an ESP32-C6 co-processor is actually wired up over SDIO to run
                ESP-Hosted -- required before Wi-Fi or Bluetooth LE (both below) can be
                enabled at all, since this project has no other transport for either.
                Pre-selected and effectively fixed for the three built-in boards, which
                all ship with the C6 soldered on; for a Custom ESP32-P4 Board, enable this
                only if you've actually wired one up yourself.

        # At least one network interface is mandatory (the web UI is the only way to edit
        # presets): without Ethernet, Wi-Fi is forced on. Fixed boards always have Ethernet
        # (APP_ENABLE_ETHERNET has no prompt there) or no Ethernet at all (Wi-Fi has no prompt
        # there and defaults to y). A configuration with neither is rejected in board_config.hpp.
        config APP_NETWORK_NEEDS_WIFI
            bool
            default y
            depends on !APP_ENABLE_ETHERNET
            select APP_ENABLE_WIFI

        if APP_ENABLE_HOSTED_COPROCESSOR
            config APP_ENABLE_WIFI
                bool "Enable Wi-Fi Subsystem (ESP-Hosted / SDIO)" if BOARD_HAS_ETHERNET
                default y
                help
                    Enables Wi-Fi connectivity via ESP-Hosted co-processor (ESP32-C6).
                    Boards without Ethernet always build it in (it is their only network
                    link). On boards with Ethernet it is optional.

            if APP_ENABLE_WIFI
                # The station's SSID/password are NOT build-time settings: they are entered in
                # the web UI (Settings -> Network) and stored in NVS (wifi_manager.hpp).
                config WIFI_MAXIMUM_RETRY
                    int "Maximum connection retries"
                    default 5
                    help
                        Number of reconnect attempts after a disconnect before giving up (and,
                        with the captive portal enabled below, opening the fallback hotspot).

                config APP_ENABLE_WIFI_CAPTIVE_PORTAL
                    bool "Fall back to an Access Point + Captive Portal if the station can't connect"
                    default y
                    select APP_ENABLE_WEBSERVER
                    help
                        Once WIFI_MAXIMUM_RETRY consecutive station connection attempts fail
                        (wrong password, AP out of range, AP down, ...) - or right at boot if no
                        network has been configured in Settings yet - start a SoftAP (SSID/
                        password below) alongside the still-retrying station and run a captive
                        portal on it: a DNS server (components/dns_server) answers every query
                        with the ESP32's own AP IP, and the web server (auto-enabled by this
                        option) redirects unknown paths to "/" so a phone joining the AP is
                        dropped straight onto that page via its OS's captive-portal detection,
                        the same way a hotel/airport Wi-Fi portal works. The station keeps
                        retrying in the background; as soon as it gets an IP, the AP and
                        captive portal shut down automatically and normal 404s come back.
                        See main/features/wifi/wifi_manager.hpp.

                if APP_ENABLE_WIFI_CAPTIVE_PORTAL
                    config WIFI_CAPTIVE_PORTAL_SSID
                        string "Captive Portal AP SSID"
                        default "ESPRESSYNTH by Jolabi"
                        help
                            SSID the fallback Access Point broadcasts while no station
                            connection is up.

                    config WIFI_CAPTIVE_PORTAL_PASSWORD
                        string "Captive Portal AP Password"
                        default ""
                        help
                            Passphrase for WIFI_CAPTIVE_PORTAL_SSID. Leave empty for an open
                            network (recommended -- a password here just adds a step before a
                            phone can reach the portal used to configure Wi-Fi in the first place).

                    config WIFI_CAPTIVE_PORTAL_RETRY_INTERVAL_SEC
                        int "Background station reconnect interval while the portal is up (seconds)"
                        default 30
                        range 5 3600
                        help
                            While the captive portal AP is up, how often to retry joining
                            the configured network in the background (another WIFI_MAXIMUM_RETRY-sized burst
                            of attempts each time) so the device reconnects on its own once the
                            real network is reachable again, without needing a reboot.
                endif
            endif

            config APP_ENABLE_BLUETOOTH
                bool "Enable Bluetooth LE Subsystem (ESP-Hosted / NimBLE)"
                default n
                # Bonding keys must survive reboots so remembered/auto-connect devices
                # (ble_manager.hpp) reconnect without re-pairing.
                select BT_NIMBLE_NVS_PERSIST if BT_NIMBLE_ENABLED
                help
                    Enables Bluetooth LE via the same ESP-Hosted co-processor (ESP32-C6) used
                    for Wi-Fi: a NimBLE host stack runs on the ESP32-P4 and talks to the BT
                    controller on the co-processor over ESP-Hosted's virtual HCI, multiplexed
                    on the shared SDIO link. Runs as a central, scanning for and connecting to
                    BLE HID (keyboards, generic HID devices) and BLE-MIDI peripherals.

            if APP_ENABLE_BLUETOOTH
                menu "Enabled BLE Central Profiles"
                    config BLE_ENABLE_HID_HOST
                        bool "HID over GATT Host (BLE Keyboards / generic HID devices)"
                        default y

                    config BLE_ENABLE_MIDI_HOST
                        bool "BLE-MIDI Host (wireless MIDI Keyboards / Controllers)"
                        default y
                endmenu
            endif
        endif

        config APP_ENABLE_COPROCESSOR_OTA
            bool "Push co-processor firmware update from the P4 at boot (Hosted OTA)"
            default n
            depends on APP_ENABLE_WIFI || APP_ENABLE_BLUETOOTH
            help
                Checks the ESP32-C6 co-processor's firmware version at boot and, if it
                differs from the image staged in the "slave_fw" partition, pushes it
                over the existing ESP-Hosted link and restarts. No-op if already up to
                date, so this is safe to leave enabled. See coprocessor_fw/README.md
                for how to build the co-processor firmware and stage it into that
                partition; main/features/hosted/hosted_ota.hpp does the push.

    endmenu

    menu "Storage"

        config APP_ENABLE_SDCARD
            bool "Enable SD Card Storage (SDMMC / TF Card)"
            default n
            help
                Enables SDMMC Slot storage driver.

        config SDMMC_LDO_CHANNEL
            int "SDMMC on-chip LDO channel" if BOARD_CUSTOM_P4
            default 4 if BOARD_JC8012P4A1
            default 4 if BOARD_JC1060P470C_7_INCH
            default 4 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
            default 4 if BOARD_CROWPANEL_5INCH
            default 1
            range 1 4
            depends on SOC_SDMMC_IO_POWER_EXTERNAL
            help
                On ESP32-P4 the dedicated SDMMC pins use the on-chip LDO for their
                signal voltage. Select the LDO channel connected to the SDMMC IO
                supply. The JC8012P4A1 and Waveshare P4 boards use LDO_VO4, which
                is channel 4. Check the board schematic before changing this value.

        config APP_ENABLE_LITTLEFS
            bool "Enable LittleFS Storage (on-chip flash, \"littlefs\" partition)"
            default y
            help
                Mounts the "littlefs" data partition (see partitions.csv) as a LittleFS
                filesystem at /littlefs, via the joltwallet/littlefs component.

    endmenu

    menu "System"

        config APP_ENABLE_CLI
            bool "Enable Serial CLI (interactive console)"
            default y
            help
                Enables an interactive command-line interface (REPL) over the
                active console port, with command history (Up/Down) and Tab
                completion. New commands can be added under main/cli/commands/.
                Type "help" for a list of available commands.

        config APP_ENABLE_ETHERNET
            bool "Enable Ethernet / LAN (RMII EMAC)" if BOARD_CUSTOM_P4
            default y
            depends on BOARD_HAS_ETHERNET
            help
                Enables 100M RJ45 Ethernet connection using the internal EMAC and PHY.
                Always built in on boards with an Ethernet PHY (BOARD_HAS_ETHERNET): the web
                UI is the only way to edit presets, so a network link is mandatory. Only the
                Custom board can switch it off - then Wi-Fi is forced on instead.

        # Always on (no prompt): the web UI is the only way to edit presets, and every build
        # has Wi-Fi or Ethernet (see APP_NETWORK_NEEDS_WIFI above).
        config APP_ENABLE_WEBSERVER
            bool
            default y
            depends on APP_ENABLE_WIFI || APP_ENABLE_ETHERNET
            help
                Starts an HTTP server (esp_http_server) serving static files from a
                dedicated "www" LittleFS partition (see partitions.csv) -- separate
                from the general-purpose "littlefs" data partition, so the web
                assets can be rebuilt and reflashed independently of the app image.
                Populate the project's data/ directory with the files to serve; see
                main/features/web/web_server.hpp and the root CMakeLists.txt for how
                that directory becomes a flashable partition image. Reachable over
                whichever of Wi-Fi/Ethernet is up, no separate wiring per interface.

    endmenu

    endmenu

endmenu

choice ESP32P4_REV_MIN
    default ESP32P4_REV_MIN_100 if WAVESHARE_P4_WIFI_DEV_KIT_BOARD
    default ESP32P4_REV_MIN_0 if BOARD_CROWPANEL_5INCH
endchoice

# Board defaults for symbols owned by other components. Project Kconfigs are parsed
# before "Component config", so these defaults win over the components' own - but only
# for a fresh sdkconfig: these symbols have visible prompts there, so a value already in
# the sdkconfig is kept. (The C6 SDIO pins are therefore not seeded here at all;
# app_startup.hpp passes the board header's pins to esp_hosted at runtime.)
choice ESP_CONSOLE_UART
    default ESP_CONSOLE_USB_SERIAL_JTAG if BOARD_JC1060P470C_7_INCH
endchoice

# The P4 has one internal FS PHY, shared by the USB-Serial/JTAG secondary console and the
# TinyUSB device (usb_device_manager.hpp checks this at compile time).
choice ESP_CONSOLE_SECONDARY
    default ESP_CONSOLE_SECONDARY_NONE if APP_ENABLE_USB_DEVICE
endchoice
