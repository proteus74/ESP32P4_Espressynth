# Board selection for the Guition JC1060P470C 7" board (1024x600 MIPI DSI, C6 Hosted).
# Combine with the common sdkconfig.defaults - see the header comment there for the
# idf.py -D SDKCONFIG_DEFAULTS invocation. Onboard ES8311 audio pins and the SDMMC LDO
# channel already default correctly for this board via the "if BOARD_JC1060P470C_7_INCH"
# conditionals in main/Kconfig.projbuild once it's selected - no need to repeat them here.
# Ethernet/RS485 are only populated on some variants of this board - enable
# "Application Features -> Enable Ethernet / LAN" yourself via menuconfig if your unit has it.
CONFIG_BOARD_JC1060P470C_7_INCH=y

# Use the ESP32-P4's built-in USB Serial/JTAG virtual COM port for logs and CLI.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
